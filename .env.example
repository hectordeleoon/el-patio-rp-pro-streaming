# ═══════════════════════════════════════════════════════════════════════════════
# EL PATIO BOT STREAM v9.5 — CONFIGURACIÓN EJEMPLO
# ⚠️ IMPORTANTE: Nunca subas el archivo real .env a GitHub
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# DISCORD - OBLIGATORIO
# ═══════════════════════════════════════════════════════════════════════════════

# Token del bot (obtener en: https://discord.com/developers/applications )
# Ejemplo: DISCORD_TOKEN=MTQ4NzY1NDMyMTA5MDEyMzQ1.Gabc12.def123...
DISCORD_TOKEN=tu_token_aqui

# IDs de Discord (Click derecho → Copiar ID en modo desarrollador)
DISCORD_CLIENT_ID=1468409863729316087
DISCORD_GUILD_ID=1287645548190498880

# Canales (FORO es obligatorio, el resto opcional pero recomendado)
DISCORD_FORUM_CHANNEL_ID=1468408367599976649
DISCORD_NOTIFICATIONS_CHANNEL_ID=1457614705064542342

# Canales específicos (si son diferentes al de notificaciones generales)
DISCORD_LIVE_CHANNEL_ID=          # Canal para @everyone cuando hay lives
DISCORD_ADMIN_CHANNEL_ID=         # Canal para solicitudes pendientes
DISCORD_CLIPS_CHANNEL_ID=         # Canal clips virales
DISCORD_POSTS_CHANNEL_ID=         # Posts redes sociales
DISCORD_GENERAL_CHANNEL_ID=       # Broadcast general
DISCORD_SCHEDULE_CHANNEL_ID=      # Horarios programados

# Roles
STREAMER_ROLE_ID=1399598985995485184
STAFF_ROLE_ID=                    # Opcional: para comandos de staff

# ═══════════════════════════════════════════════════════════════════════════════
# SEGURIDAD - OBLIGATORIO
# ═══════════════════════════════════════════════════════════════════════════════

# 🔴 CAMBIA ESTO EN PRODUCCIÓN - Genera algo seguro:
# node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
DASHBOARD_ADMIN_KEY=cambia_esto_por_una_clave_larga_y_segura_32chars_min

# Opcional: clave secundaria para staff (no puede borrar streamers)
DASHBOARD_STAFF_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# TWITCH API - RECOMENDADO PARA FUNCIONAMIENTO COMPLETO
# ═══════════════════════════════════════════════════════════════════════════════
# Obtener en: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=tu_twitch_client_id_real_aqui
TWITCH_CLIENT_SECRET=tu_twitch_client_secret_real_aqui
ENABLE_TWITCH=true

# ═══════════════════════════════════════════════════════════════════════════════
# OTRAS PLATAFORMAS
# ═══════════════════════════════════════════════════════════════════════════════
ENABLE_KICK=true
ENABLE_TIKTOK=true

# YouTube (requiere API Key de Google Cloud)
ENABLE_YOUTUBE=false
YOUTUBE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# IA (OPCIONAL) - Para análisis de clips automáticos
# ═══════════════════════════════════════════════════════════════════════════════
# Obtener en: https://console.groq.com/keys (gratis)
GROQ_API_KEY=
FEATURE_AUTO_CLIP_GENERATION=false
VIRAL_SCORE_AUTO_PUBLISH_THRESHOLD=70
MIN_VIEWERS_TO_CLIP=10

# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN TÉCNICA
# ═══════════════════════════════════════════════════════════════════════════════
PORT=3000
CHECK_INTERVAL=60000
NOTIFICATION_COOLDOWN=30

# Filtro de contenido (experimental)
CONTENT_FILTER_ENABLED=true
CONTENT_FILTER_CONFIDENCE=0.6

# Tienda
SHOP_VIP_ROLE_ID=
