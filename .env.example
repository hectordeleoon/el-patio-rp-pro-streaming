# ═══════════════════════════════════════════════════════════════════════════════
#                    EL PATIO BOT STREAM v7.0 — CONFIGURACIÓN
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
#                    DISCORD BOT (REQUERIDO)
# ═══════════════════════════════════════════════════════════════════════════════

# Token del bot (obtener en: https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# Client ID del bot (Application ID)
DISCORD_CLIENT_ID=1468409863729316087

# ID del servidor (Guild ID)
DISCORD_GUILD_ID=1287645548190498880

# ═══════════════════════════════════════════════════════════════════════════════
#                    CANALES DE DISCORD (REQUERIDO)
# ═══════════════════════════════════════════════════════════════════════════════

# Canal de tipo FORO donde se crearán los hilos de streamers
DISCORD_FORUM_CHANNEL_ID=1468408367599976649

# Canal donde se enviarán las notificaciones de live
DISCORD_NOTIFICATIONS_CHANNEL_ID=1457614705064542342

# Canal donde se enviarán los clips (opcional)
DISCORD_CLIPS_CHANNEL_ID=1457614566417764372

# ═══════════════════════════════════════════════════════════════════════════════
#                    ROLES (REQUERIDO)
# ═══════════════════════════════════════════════════════════════════════════════

# Rol que se asignará a los streamers registrados
STREAMER_ROLE_ID=1399598985995485184

# ═══════════════════════════════════════════════════════════════════════════════
#                    TWITCH API (OPCIONAL - RECOMENDADO)
# ═══════════════════════════════════════════════════════════════════════════════

# Obtener en: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret

# ═══════════════════════════════════════════════════════════════════════════════
#                    YOUTUBE API (OPCIONAL)
# ═══════════════════════════════════════════════════════════════════════════════

# Obtener en: https://console.cloud.google.com/apis/credentials
# Necesitas habilitar "YouTube Data API v3"
YOUTUBE_API_KEY=tu_youtube_api_key

# ═══════════════════════════════════════════════════════════════════════════════
#                    CONFIGURACIÓN DE NOTIFICACIONES
# ═══════════════════════════════════════════════════════════════════════════════

# Intervalo de verificación en milisegundos (default: 60000 = 1 minuto)
# Mínimo recomendado: 30000 (30 segundos)
# Máximo recomendado: 120000 (2 minutos)
CHECK_INTERVAL=60000

# Cooldown entre notificaciones del mismo streamer en minutos (default: 30)
# Esto evita spam cuando un streamer reinicia su transmisión
# Mínimo: 5 minutos | Máximo: 120 minutos
NOTIFICATION_COOLDOWN=30

# ═══════════════════════════════════════════════════════════════════════════════
#                    ACTIVAR/DESACTIVAR PLATAFORMAS
# ═══════════════════════════════════════════════════════════════════════════════

ENABLE_TWITCH=true
ENABLE_KICK=true
ENABLE_TIKTOK=true
ENABLE_YOUTUBE=false

# ═══════════════════════════════════════════════════════════════════════════════
#                    DASHBOARD WEB
# ═══════════════════════════════════════════════════════════════════════════════

# Clave de administrador para acceder al dashboard
DASHBOARD_ADMIN_KEY=elpatio-admin-2026

# Puerto del servidor web
PORT=3000

# ═══════════════════════════════════════════════════════════════════════════════
#                    SISTEMA DE CLIPS (OPCIONAL)
# ═══════════════════════════════════════════════════════════════════════════════

# Activar sistema de clips virales (requiere GROQ_API_KEY)
FEATURE_AUTO_CLIP_GENERATION=false

# API Key de Groq (gratis en: https://console.groq.com)
GROQ_API_KEY=gsk_tu_groq_api_key

# Umbral de viralidad (0-100, default: 70)
VIRAL_SCORE_AUTO_PUBLISH_THRESHOLD=70
